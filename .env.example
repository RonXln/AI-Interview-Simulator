# =====================================================
# 面试模拟器环境变量样例
# 使用方式：复制本文件为 .env，然后填入真实值
# .env 已被 .gitignore 排除，不会提交到仓库
# =====================================================

# --- DeepSeek LLM ---
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# --- 本地 TTS (edge-tts via Python) ---
# Windows 示例：C:\\Users\\YOU\\AppData\\Local\\Programs\\Python\\Python314\\python.exe
# macOS/Linux 示例：/usr/bin/python3
TTS_PYTHON_CMD=python
TTS_SCRIPT_PATH=tts.py

# --- 阿里云百炼 DashScope（Paraformer-Realtime-v2 ASR）---
# API Key：https://bailian.console.aliyun.com → 右上角 → API-KEY 管理
DASHSCOPE_API_KEY=sk-your-dashscope-key-here
# 业务空间专属域名（推荐）；缺省域名亦可：wss://dashscope.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_WS_URL=wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
ASR_MODEL=paraformer-realtime-v2
